# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/<database_name>?retryWrites=true&w=majority"
MONGODB_DB_NAME="database_name"

# Required JWT signing secret (generate a unique random value of at least 32 characters)
AUTH_SECRET=""

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Exchange Rate API Key (e.g. ExchangeRate-API, open.er-api.com works without key as well)
EXCHANGE_RATE_API_KEY=""
