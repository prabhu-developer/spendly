# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/<database_name>?retryWrites=true&w=majority"
MONGODB_DB_NAME="database_name"

# Required JWT signing secret, at least 32 characters.
# Generate one with: openssl rand -base64 48
AUTH_SECRET=""

# Public base URL. Also trusted as an allowed Origin for state-changing API requests
# (needed when the app is served behind a proxy that rewrites the Host header).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Exchange Rate API Key (e.g. ExchangeRate-API, open.er-api.com works without key as well)
EXCHANGE_RATE_API_KEY=""

# Environment variables are validated on first request (lib/env.ts); the app fails
# fast with a list of missing/invalid variable names (values are never logged).
